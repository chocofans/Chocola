<Project>
  <PropertyGroup>
    <Configuration>DebugPortable</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>$(MSBuildProjectDirectory)\..\bin\DebugPortable\choco_data\</PublishDir>
  </PropertyGroup>
</Project>
